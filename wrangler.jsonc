{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "water5-auth",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "routes": [
    { "pattern": "auth.water555.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
